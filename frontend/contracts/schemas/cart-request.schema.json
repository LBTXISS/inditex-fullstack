{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "colorCode", "storageCode"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "colorCode": { "type": "number" },
    "storageCode": { "type": "number" }
  },
  "additionalProperties": false
}
