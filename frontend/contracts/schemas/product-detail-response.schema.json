{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:itx:product-detail-response:v1",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "brand", "model", "price", "imgUrl", "options"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "brand": { "type": "string" },
    "model": { "type": "string" },
    "price": { "type": "string" },
    "imgUrl": { "type": "string", "minLength": 1 },
    "options": {
      "type": "object",
      "additionalProperties": true,
      "required": ["colors", "storages"],
      "properties": {
        "colors": { "$ref": "#/$defs/options" },
        "storages": { "$ref": "#/$defs/options" }
      }
    }
  },
  "$defs": {
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name"],
        "properties": {
          "code": { "type": "number" },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
