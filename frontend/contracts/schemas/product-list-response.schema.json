{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:itx:product-list-response:v1",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": ["id", "brand", "model", "price", "imgUrl"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "brand": { "type": "string" },
      "model": { "type": "string" },
      "price": { "type": "string" },
      "imgUrl": { "type": "string", "minLength": 1 }
    }
  }
}
